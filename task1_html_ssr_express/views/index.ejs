<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <main class="container">
    <h1><%= title %></h1>
    <p>Submit the intake form below to verify Express + EJS server-side rendering.</p>
    <form action="/submit" method="POST" aria-label="User intake form">
      <label for="fullName">Full Name</label>
      <input id="fullName" name="fullName" type="text" required minlength="2" />
      <label for="email">Email Address</label>
      <input id="email" name="email" type="email" required />
      <label for="track">Engineering Track</label>
      <select id="track" name="track">
        <option value="Full-Stack">Full-Stack</option>
        <option value="DevSecOps">DevSecOps</option>
        <option value="AI Engineering">AI Engineering</option>
      </select>
      <button type="submit">Submit Intake</button>
    </form>
  </main>
</body>
</html>
